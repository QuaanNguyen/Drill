{
  "schema_version": 2,
  "name": "Restricted example research",
  "objective": {
    "metric": "squared_error",
    "direction": "minimize",
    "unit": "error",
    "min_improvement": 1
  },
  "constraints": [
    {"metric": "constraint_violations", "op": "==", "value": 0}
  ],
  "evaluator": {
    "adapter": "../toy/evaluator.py",
    "timeout_seconds": 10
  },
  "agent": {
    "adapter": "agent.py",
    "timeout_seconds": 240
  },
  "research": {
    "brief": "Improve the supplied parameter baseline using the fixed evaluator. Make one small change per experiment.",
    "editable_paths": ["parameters.json"],
    "max_iterations": 5,
    "budget_seconds": 10
  }
}
